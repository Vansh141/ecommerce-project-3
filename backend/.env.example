# ─────────────────────────────────────────────────────────────────────────────
#  TOUCH — Backend environment
#
#  Copy to `.env` and fill in. NEVER commit `.env`.
#  The server validates this file on boot and refuses to start if anything
#  required is missing or weak, so a misconfigured deploy fails loudly.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# REQUIRED. There is deliberately no localhost fallback — a missing value is an
# error, not a silent connection to a non-existent local database.
MONGO_URI=mongodb://127.0.0.1:27017/touch

# ── Secrets — REQUIRED, minimum 32 characters, must differ from each other ────
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Placeholder values ("secret", "changeme", …) are rejected at boot.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_MS=2592000000
JWT_ISSUER=touch-api

# ── Client / CORS ────────────────────────────────────────────────────────────
# REQUIRED in production. Used for password-reset links and order links in
# emails, and as the default CORS origin.
CLIENT_URL=http://localhost:5173

# Optional comma-separated allowlist. Defaults to CLIENT_URL.
# CORS_ORIGINS=https://touch.example.com,https://www.touch.example.com

# ── Cookies ──────────────────────────────────────────────────────────────────
# `lax`   — API and site share a registrable domain (recommended)
# `none`  — API and site are on different sites; REQUIRES HTTPS
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.touch.example.com

# ── Proxy ────────────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the app. Must be exact: too high makes
# X-Forwarded-For spoofable and defeats rate limiting; too low makes every
# visitor share one rate-limit bucket. 0 = no proxy (local dev).
TRUST_PROXY=0

# ── Email (optional; password reset and order emails are disabled without it) ─
# Delivered via the Resend HTTPS API. SMTP is deliberately not used: Render
# blocks outbound ports 25/465/587, so smtp.gmail.com fails with ENETUNREACH.
# Key from https://resend.com/api-keys — starts with "re_".
RESEND_API_KEY=
# Bare address (no display name) on a domain verified in Resend.
RESEND_FROM_EMAIL=
MAIL_FROM_NAME=TOUCH
# Where contact-form enquiries are delivered. Defaults to RESEND_FROM_EMAIL.
CONTACT_NOTIFY_EMAIL=

# ── Razorpay (optional; online payment is disabled without it — COD still works)
# From the Razorpay dashboard. Only the KEY_ID is ever sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you create the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ── This API's own public origin ─────────────────────────────────────────────
# Only needed when Cloudinary is NOT configured and the storefront lives on a
# different origin than the API. Uploaded images are then served from this API,
# and their URLs must be absolute or the browser resolves them against the
# storefront and gets a 404. Configuring Cloudinary is the better answer —
# local disk is wiped on every redeploy on Render and similar hosts.
# API_PUBLIC_URL=https://touch-api.onrender.com

# ── Cloudinary (optional; falls back to local disk, which is ephemeral in prod)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=touch/products

# ── Storefront commerce settings ─────────────────────────────────────────────
STORE_NAME=TOUCH
STORE_CURRENCY=INR
FREE_SHIPPING_THRESHOLD=1499
SHIPPING_FLAT_RATE=79
# GST rate. Indian apparel prices are tax-inclusive, so this is displayed as a
# component of the total rather than added on top.
TAX_RATE=0.05
TAX_INCLUSIVE=true
COD_ENABLED=true
COD_MAX_ORDER_VALUE=20000
MAX_QTY_PER_ITEM=10
ORDER_CANCEL_WINDOW_HOURS=24
LOW_STOCK_THRESHOLD=5

# ── Admin bootstrap (used only by `npm run seed:admin`) ──────────────────────
# Set, run the command once, then remove these values from the file.
ADMIN_NAME=Store Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
